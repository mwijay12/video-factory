# ============================================================
# VIDEOFACTORY ENVIRONMENT VARIABLES - EXAMPLE TEMPLATE
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git
# ============================================================

# --- AI Script Generation ---
# Groq: https://console.groq.com/ (Primary - fastest, free)
GROQ_API_KEY=gsk_your_groq_key_here
# Optional comma-separated rotation pool
GROQ_KEYS=

# Gemini: https://aistudio.google.com/ (Secondary - best Swahili)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_KEYS=

# OpenRouter: https://openrouter.ai/keys (Tertiary fallback - free models)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_KEYS=

# --- Stock Media APIs ---
# Pexels: https://www.pexels.com/api/ (Free - 20k requests/month)
PEXELS_API_KEY=your_pexels_key_here

# Pixabay: https://pixabay.com/api/docs/ (Free - additional stock source)
PIXABAY_API_KEY=your_pixabay_key_here

# --- TTS Providers ---
# ElevenLabs: https://elevenlabs.io/ (10k free chars/month)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_KEYS=

# Puter: Copy from puter.com dashboard developer console
# Used for Gemini TTS voices - MUCH better Swahili than Edge-TTS
PUTER_TOKEN=your_puter_token_here

# --- Optional: Local Ollama (offline LLM fallback) ---
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_KEYS=

# --- Trending / News APIs (all optional, free tiers) ---
NEWSAPI_KEY=
NEWSAPI_KEYS=
GNEWS_KEY=
GNEWS_KEYS=
GUARDIAN_KEY=

# --- Cloudflare Workers AI (optional daily brief analysis) ---
CF_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional fallback accounts (JSON array). Never hardcode keys in source.
# Example: [{"account_id": "abc123", "api_token": "cfut_xxx"}]
CLOUDFLARE_BACKUP_ACCOUNTS=

# --- Telegram control bot (optional) ---
TELEGRAM_BOT_TOKEN=

# --- YouTube Data API (optional metadata helpers) ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Video Publishing Platforms ---
# Which platforms to auto-post to (comma-separated)
# Options: youtube, instagram, tiktok
PUBLISH_PLATFORMS=youtube,instagram,tiktok

# --- Optional: OpenAI (for GPT-4o script generation if needed) ---
# OPENAI_API_KEY=sk-your_openai_key_here

# --- Maintenance / retention ---
MAX_VIDEO_AGE_DAYS=30
TEMP_FILE_MAX_AGE_DAYS=3
TRACK_ASSET_CREDITS=true

# --- App Config ---
# Set to true during testing to skip actual API calls
TEST_MODE=false

# Default language: english or swahili
DEFAULT_LANGUAGE=english

# Default niche: gospel, motivational, tech, swahili
DEFAULT_NICHE=gospel
